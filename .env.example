# Server-only AI credentials. Never expose OPENAI_API_KEY in public/config.js.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Supabase project URL and publishable/anon key for browser auth config.
# Set these values in public/config.js (publishable key is designed for browser use).
SUPABASE_URL=
SUPABASE_ANON_KEY=
PORT=3000
